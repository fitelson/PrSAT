{
  "name": "prsat-3.1-experimental",
  "private": true,
  "version": "3.1.0-experimental",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.2.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy-files": "cp node_modules/z3-solver/build/z3-built.js node_modules/z3-solver/build/z3-built.wasm public",
    "build": "npm run copy-files && tsc && vite build",
    "lint": "eslint src tests *.config.ts --max-warnings=0",
    "preview": "vite preview",
    "test:unit": "vitest --run --no-file-parallelism",
    "test:e2e": "playwright test --project chromium",
    "test": "npm run test:unit && npm run test:e2e",
    "test-single": "vitest --allowOnly",
    "maple-bridge": "node maple_bridge/server.mjs",
    "install-local-web": "zsh scripts/install_local_web.zsh"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/parsimmon": "^1.10.9",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "playwright": "1.64.0",
    "typescript": "npm:@typescript/typescript6@6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "parsimmon": "^1.18.1",
    "z3-solver": "^5.2.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
