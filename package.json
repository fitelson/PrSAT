{
  "name": "prsat-3.1-experimental",
  "private": true,
  "version": "3.1.0-experimental",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "copy-files": "cp node_modules/z3-solver/build/z3-built.js node_modules/z3-solver/build/z3-built.wasm public",
    "build": "npm run copy-files && tsc && vite build",
    "lint": "eslint src tests *.config.ts --max-warnings=0",
    "preview": "vite preview",
    "test:unit": "vitest --run --no-file-parallelism",
    "test:e2e": "playwright test --project chromium",
    "test": "npm run test:unit && npm run test:e2e",
    "test-single": "vitest --allowOnly",
    "maple-bridge": "node maple_bridge/server.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.1",
    "@types/parsimmon": "^1.10.9",
    "@vitest/browser": "^4.1.10",
    "eslint": "^10.6.0",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "parsimmon": "^1.18.1",
    "z3-solver": "^4.16.0"
  }
}
